# =============================================================================
# dev 环境（本地测试 / 调试）
#
# 加载顺序：config/device.env（公共基线） -> config/profiles/<XPHONE_ENV>.env（本文件覆盖）
# 生效方式：docker compose 通过 environment 传入 XPHONE_ENV=dev，或 ./scripts/up.sh dev
#
# 设计目标：能起来、能 adb、好排查。不追求真机化，也不引入会掩盖问题的加固。
# =============================================================================

# ---------------------------- 加固：dev 全部关闭 ----------------------------
# 真机化属性注入与痕迹清理关掉，方便在 getprop 里看清哪些是原生值、哪些是注入值
STEALTH=0
STEALTH_PRELOAD=0               # dev 绝不注入 hook 库（避免排障时被伪造值误导）
STEALTH_RENAME_NET=0
STEALTH_FAKE_CMDLINE=0
STEALTH_BATTERY=0               # 电池伪装会干扰自动化脚本的状态判断
XFAKE_DEBUG=1                   # hook 库日志（dev 时打开；STEALTH_PRELOAD=1 才有输出）

# ---------------------------- root 与 SELinux -------------------------------
ROOT_MODE=adb                   # adb shell 直接 uid 0，排查问题最省事
SELINUX=permissive              # 避免标签问题把定制环节挡住（生产环境由 prod.env 改回 enforcing）

# ---------------------------- 显示 / 渲染（省资源优先）----------------------
WIDTH=720                       # 小分辨率省 CPU；测完再改回 1080x2400
HEIGHT=1280
DPI=320
FPS=15                          # 软件渲染下 15fps 足够，30fps 会白烧 CPU
GPU_MODE=guest                  # 软件渲染，不依赖 /dev/dri（无 GPU 的机器上也能跑）

# ---------------------------- 调试友好项 ------------------------------------
DISABLE_ANIMATION=1             # 关过渡动画，自动化脚本更稳
KEEP_SCREEN_ON=1
DISABLE_LOCKSCREEN=1

# =============================================================================
# prod 环境（Linux 生产实例）
#
# 加载顺序：config/device.env（公共基线） -> config/profiles/<XPHONE_ENV>.env（本文件覆盖）
# 生效方式：docker compose 通过 environment 传入 XPHONE_ENV=prod，或 ./scripts/up.sh prod
# 前置条件（up.sh prod 会自动预检）：Linux 宿主 + binder/binderfs 就绪 + arm64 架构
#
# 设计目标：贴近真机、稳定、可审计。所有开关都指向「抗检测 + 生产可用性」。
# =============================================================================

# ---------------------------- 真机化加固：全部开启 --------------------------
STEALTH=1                       # 属性注入 + 痕迹清理 + build.prop 双写
STEALTH_BATTERY=1               # 电池伪装（云手机常年满电是很明显的特征）
STEALTH_RENAME_NET=1            # eth0 -> wlan0（★上量前先单实例验证 netd）
STEALTH_FAKE_CMDLINE=1          # 尝试伪造 /proc/cmdline（不允许时自动跳过）
# 二进制层：必须为 1 之前先跑完 ./scripts/test-preload.sh --enable
STEALTH_PRELOAD=1
# XFAKE_DEBUG=1                 # 生产环境务必保持注释：日志会把伪造行为打出来

# ---------------------------- root 与 SELinux -------------------------------
ROOT_MODE=magisk                # 属性面保持 user 版（ro.secure=1/debuggable=0），root 交给 Magisk
                                # 若基础镜像没有预置 Magisk，先改回 adb，否则 adb shell 不是 root
SELINUX=enforcing               # 真机即 enforcing；xattr 不可用时 entrypoint 自动降级并告警

# ---------------------------- 显示 / 渲染 -----------------------------------
WIDTH=1080
HEIGHT=2400
DPI=420
FPS=30
GPU_MODE=auto                   # auto 自动探测：有 /dev/dri 走直通，没有则软件渲染
                                # 明确有 GPU 时改 host，并打开 docker-compose.prod.yml 的 /dev/dri

# ---------------------------- 生产可用性 ------------------------------------
DISABLE_ANIMATION=1
KEEP_SCREEN_ON=1
DISABLE_LOCKSCREEN=1

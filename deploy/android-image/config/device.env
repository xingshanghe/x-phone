# =============================================================================
# 设备配置：容器启动时由 entrypoint.sh 读取（config 目录整体挂到 /xphone）
# 所有 ★ 标记的项请按自己的目标机型替换。
#
# 优先级：本文件 < config/props/runtime-ro.prop < docker compose 的 command 追加参数
# 多实例：为每个实例复制一份本目录，改下面的值 + ADB_PORT + DATA_DIR 即可。
# =============================================================================

# ---------------------------- 显示 / 渲染（改完 restart 生效）-----------------
WIDTH=1080          # ★ 分辨率宽（androidboot.redroid_width）
HEIGHT=2400         # ★ 分辨率高
DPI=420             # ★ 屏幕密度（wm density）
FPS=30              # 帧率上限；软件渲染建议 30，GPU 直通可 60
GPU_MODE=guest      # guest=软件渲染（稳） / host=GPU 直通（需挂 /dev/dri） / auto
# GPU_NODE=/dev/dri/renderD128   # GPU_MODE=host 时指定渲染节点，留空自动探测
USE_MEMFD=1         # 内核 >=5.18 无 ashmem，必须 1
# 真机为 enforcing，permissive 本身是检测特征，默认 enforcing。
# entrypoint 会用 canary 文件实测 chcon：宿主文件系统不支持 security.* xattr 时
# 自动降级为 permissive 并在日志告警（docker logs 里看 xphone:entry 的 WARN）。
SELINUX=enforcing

# ---------------------------- root 与调试 ------------------------------------
# adb    = ro.secure=0，adb shell 直接 root（功能验证首选，但 debuggable=1 是明显检测特征）
# magisk = 属性面保持 user 版（ro.secure=1 / debuggable=0），root 由 Magisk 提供 —— 抗检测场景用这个
# none   = 不开放 root
ROOT_MODE=adb
VERIFIED_BOOT_STATE=orange   # androidboot.verifiedbootstate；真机化时配合 DEVICE_BOOT_VERIFIED=green

# ---------------------------- 机型 / 设备指纹（★ 重点替换）-------------------
DEVICE_BRAND=google
DEVICE_MANUFACTURER=Google
DEVICE_MODEL=Pixel 8
DEVICE_DEVICE=shiba
DEVICE_PRODUCT=shiba
DEVICE_BOARD=shiba
DEVICE_HARDWARE=shiba
DEVICE_RELEASE=14
DEVICE_SDK=34
DEVICE_ID=UQ1A.240205.002
DEVICE_DISPLAY=UQ1A.240205.002
DEVICE_BUILD_TYPE=user
DEVICE_BUILD_TAGS=release-keys
DEVICE_FINGERPRINT=google/shiba/shiba:14/UQ1A.240205.002/11224170:user/release-keys
DEVICE_SERIAL=R8CTX0A0A0A    # ★ 设备序列号（adb devices 与 getprop ro.serialno 可见）
DEVICE_GPU=Mali-G715         # ro.hardware.egl，应用侧 GLES 字符串来源之一

# ---------------------------- CPU ABI（★ 按宿主架构确认）---------------------
# arm64 宿主（抗检测场景的正确选择）：
DEVICE_ABILIST=arm64-v8a,armeabi-v7a,armeabi
DEVICE_ABILIST64=arm64-v8a
DEVICE_ABILIST32=armeabi-v7a,armeabi
# x86_64 宿主（/proc/cpuinfo 会暴露 Intel/AMD，无法伪装成真机，仅用于功能验证）：
# DEVICE_ABILIST=x86_64,arm64-v8a,x86,armeabi-v7a,armeabi
# DEVICE_ABILIST64=x86_64,arm64-v8a
# DEVICE_ABILIST32=x86,armeabi-v7a,armeabi
# ARM 翻译层：仅 x86 宿主需要；它本身就是最明显的检测特征，arm64 宿主请勿开启
# NATIVE_BRIDGE=libndk_translation.so

# ============================ 真机化加固（★ 重点）============================
# 详见 docs/stealth.md。原则：整套属性必须自洽，建议用
#   ./scripts/capture-props.sh --serial <真机> --out config/profiles/xxx.env
# 从真机抓取，不要手编 fingerprint。
STEALTH=1                       # 1=开启真机化属性注入与痕迹清理
DEVICE_BOOTLOADER=ripcurrent-14.4-11440000   # ★ ro.bootloader / ro.build.expect.bootloader
DEVICE_BASEBAND=g5300i-240205-240209-B-11424045  # ★ gsm.version.baseband
DEVICE_SECURITY_PATCH=2024-02-05             # ★ 需与 fingerprint 的 build id 同代
DEVICE_INCREMENTAL=11224170                  # ★ 指纹末段的构建号
DEVICE_FIRST_API_LEVEL=33                    # 真机 30+；容器常缺失
DEVICE_BUILD_DATE_UTC=1708473600             # ★ 构建时间戳（UTC 秒）
DEVICE_REVISION=MP1.0                        # ro.revision
DEVICE_BOOT_VERIFIED=green                   # ro.boot.verifiedbootstate：green=官方锁定
DEVICE_FLASH_LOCKED=1                        # ro.boot.flash.locked
DEVICE_VBMETA_STATE=locked                   # ro.boot.vbmeta.device_state

# 网络外形（改动会影响 netd，先在单实例上验证再上量）
STEALTH_RENAME_NET=0            # 1=把 eth0 改名为 wlan0（更像真机，★需实测）
STEALTH_MAC=                    # 留空不改；形如 3A:9F:1C:88:2B:04，避免 docker 的 02:42: OUI
STEALTH_BATTERY=1               # 电池伪装：放电中 + 非满电
BATTERY_LEVEL=78
BATTERY_STATUS=3                # 2=charging 3=discharging 5=full

# ---- 二进制层（Damru 同思路：替换 GPU 驱动字符串 + LD_PRELOAD 伪造硬件读数）----
# ⚠ 该库注入系统全部 native 进程，缺陷可能造成开机循环，默认关闭。
# 启用流程（三步，勿跳步）：
#   1) NDK=/path/to/ndk ./native/xphone-fake/build-ndk.sh      # 编出库
#   2) ./scripts/test-preload.sh                               # 免重启冒烟
#   3) ./scripts/test-preload.sh --enable                      # 开启+验证，失败自动回滚
# 紧急恢复：touch config/fake/disable && docker restart（文件保险丝让库全直通）
STEALTH_PRELOAD=0               # 1=启用（需先编好库并通过 test-preload.sh 验证）
STEALTH_FAKE_CMDLINE=0          # 1=尝试伪造 /proc/cmdline（多数环境不允许，失败自动跳过）
XFAKE_DIR=/xphone/fake
XFAKE_CPU_COUNT=8               # ★ 与 config/fake/cpuinfo 的 processor 段数一致
XFAKE_MEM_MB=8192               # ★ 与 config/fake/meminfo 的 MemTotal 对齐
XFAKE_GL_VENDOR=Qualcomm
XFAKE_GL_RENDERER=Adreno (TM) 740    # ★ 换成目标机型的 GPU 字符串
XFAKE_GL_VERSION=OpenGL ES 3.2 V@0502.0
# XFAKE_DEBUG=1                 # 打开 hook 库的 stderr 日志（排障用，正式环境关掉）

# 固定的设备标识（不设则每次全新 /data 会重新生成）
# ANDROID_ID=1a2b3c4d5e6f7a8b   # 16 位十六进制

# ---------------------------- 语言 / 时区（★ 中文默认已配好）-----------------
LOCALE=zh-CN
LANGUAGE_CODE=zh
COUNTRY_CODE=CN
TIMEZONE=Asia/Shanghai
# DEFAULT_IME=com.android.inputmethod.latin/.LatinIME   # 预装中文输入法后改这里

# ---------------------------- 云手机系统行为 ---------------------------------
KEEP_SCREEN_ON=1        # 屏幕常亮
DISABLE_LOCKSCREEN=1    # 禁用锁屏
DISABLE_ANIMATION=1     # 关闭过渡动画（省 CPU、提升自动化稳定性）
# DEFAULT_LAUNCHER=com.example.launcher/.MainActivity  # 替换 Launcher3 后设置默认桌面
# HTTP_PROXY_HOST=127.0.0.1   # 需要出网代理时填（容器视角的地址）
# HTTP_PROXY_PORT=8888

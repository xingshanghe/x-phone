# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

IMAGE=xphone/android
TAG=14-custom

# ★ 运行环境分层：dev=本地测试（弱加固、省资源） / prod=Linux 生产（真机化全开）
#   entrypoint 会据此加载 config/profiles/<XPHONE_ENV>.env 覆盖 config/device.env
#   生产务必为 prod。切换最省事的方式：./scripts/up.sh dev|prod（会自动改写这一行）
XPHONE_ENV=dev

# 留空则由环境覆盖层决定：dev=xphone-android-dev / prod=xphone-android-01
# 显式指定会同时作用于两种环境，多实例时才需要逐个命名
# CONTAINER_NAME=xphone-android-01

# 宿主端口（容器内固定 5555）。x-phone 端口规范：ADB 用 18120–18219 段
ADB_PORT=18120
# 只允许本机访问；确认需要远程时再改成 0.0.0.0，并配合防火墙/隧道使用
ADB_BIND_ADDR=127.0.0.1

# 持久化数据目录（Android /data 分区）
# dev 与 prod 建议分开：dev=./runtime/data-dev，prod=/var/lib/xphone/data
DATA_DIR=./runtime/data-dev

# 资源上限（dev 可降到 1.0 / 2g；compose 覆盖层有各自的默认值）
CPU_LIMIT=2.0
MEM_LIMIT=4g
